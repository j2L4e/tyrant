# Force a specific module (optional, auto-detected if unset)
# TRANSCRIPTION=whisper    # whispercpp, whisper, mistral, noop
# OUTPUT=portal            # portal, xdotool, noop
# HOTKEY=portal            # portal, pynput (push-to-talk)
# NOTIFICATION=notify-send # notify-send, noop

# Typing
# TYPING_DELAY_MS=12       # delay between typed characters (portal: default 12 with slight jitter; xdotool: its own default if unset)

# Whisper (local transcription)
# WHISPER_MODEL=base             # tiny, base, small, medium, large-v3
# WHISPER_DEVICE=auto            # auto, cpu, cuda
# WHISPER_COMPUTE_TYPE=auto      # auto, float16, int8, int8_float16

# whisper.cpp (local GPU transcription, needs pywhispercpp built with Vulkan, see README)
# WHISPERCPP_MODEL=large-v3-turbo # defaults to WHISPER_MODEL; e.g. medium, large-v3-turbo, large-v3-turbo-q5_0

# Mistral (API transcription)
# MISTRAL_API_KEY=your_api_key_here
# MISTRAL_MODEL=voxtral-mini-2602
# MISTRAL_CONTEXT_BIAS=Kubernetes,K8s,PostgreSQL
